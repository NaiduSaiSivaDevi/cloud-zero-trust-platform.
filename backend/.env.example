# Supabase PostgreSQL connection string (replace placeholders with your project values)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Optional Supabase API keys
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=[YOUR-SUPABASE-ANON-KEY]

# JWT signing secret
JWT_SECRET_KEY=replace-with-a-strong-random-secret

# Required for Vercel deployments
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Optional Monitoring / ELK
PROMETHEUS_URL=
ELASTICSEARCH_URL=
